# PostgreSQL 16; match the local database credentials. Never commit real secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Generate a random secret locally; register the callback /api/auth/callback/google in Google Cloud.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Server-only Places API (New) key. Do not use a NEXT_PUBLIC_ prefix.
GOOGLE_PLACES_API_KEY=
