# PostgreSQL 16; match the local database credentials. Never commit real secrets.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
# Generate a random secret locally; register the callback /api/auth/callback/google in Google Cloud.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Mobile app login (T18): comma-separated iOS/Android OAuth client IDs accepted as the ID token `aud`.
# Empty rejects every app login. Not secret, but keep real values in apps/server/.env.local.
GOOGLE_MOBILE_CLIENT_IDS=
# Server-only Places API (New) key. Do not use a NEXT_PUBLIC_ prefix.
GOOGLE_PLACES_API_KEY=
# Server-only Routes API key. Completed route response caching is disabled (ADR 0005).
GOOGLE_ROUTES_API_KEY=

# Browser-only Maps JavaScript key: restrict HTTP referrers and API scope in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
