{
  "name": "@travel/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "exports": {
    "./scheduler": "./src/scheduler/index.ts",
    "./scheduler/*": "./src/scheduler/*.ts",
    "./fare": "./src/fare/index.ts",
    "./contracts/*": "./src/contracts/*.ts",
    "./presentation": "./src/presentation/index.ts"
